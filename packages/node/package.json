{
  "name": "@repeato/ocr",
  "description": "Repeato OCR for Node.js main threads and Electron renderers, based on PaddleOCR and ONNX Runtime",
  "keywords": [
    "ocr",
    "paddleocr",
    "typescript",
    "onnxruntime",
    "node",
    "electron"
  ],
  "version": "1.5.20",
  "type": "module",
  "main": "./build/node/index.js",
  "types": "./build/node/src/index.d.ts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/repeato-qa/ocr.git",
    "directory": "packages/node"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./build/node/src/index.d.ts",
      "require": "./build/node/index.cjs",
      "import": "./build/node/index.js",
      "default": "./build/node/index.js"
    },
    "./electron": {
      "types": "./build/browser/src/electron.d.ts",
      "node": {
        "require": "./build/node/electron.cjs",
        "import": "./build/node/electron.js"
      },
      "require": "./build/node/electron.cjs",
      "import": "./build/browser/src/electron.js",
      "default": "./build/browser/src/electron.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "build",
    "README.md",
    "!**/__tests__"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('build', { recursive: true, force: true })\" && npx --no-install tsc --project tsconfig.build.json && npx --no-install tsc-alias --project tsconfig.build.json && npx --no-install tsc --project ../browser/tsconfig.build.json && npx --no-install tsc-alias --project ../browser/tsconfig.build.json && node ./scripts/copy-browser-build.mjs && node ./scripts/bundle-node-package.mjs && node ./scripts/copy-model-assets.mjs && node ./scripts/copy-windows-runtime-assets.mjs",
    "test:exports": "npm run build && node --test ./tests/electron-exports.test.mjs",
    "pack:verify": "node ./scripts/verify-packed-package.mjs",
    "prepack": "node -e \"require('node:fs').copyFileSync('../../README.md', 'README.md')\" && npm run build",
    "postpack": "node -e \"const fs = require('node:fs'); if (fs.existsSync('README.md')) fs.rmSync('README.md');\""
  },
  "dependencies": {
    "@gutenye/ocr-common": "^1.2.0",
    "onnxruntime-node": "1.22.0-rev",
    "onnxruntime-web": "^1.17.3"
  },
  "peerDependencies": {
    "sharp": "^0.34.5"
  },
  "peerDependenciesMeta": {
    "sharp": {
      "optional": false
    }
  },
  "devDependencies": {
    "sharp": "^0.34.5"
  }
}