{
  "name": "@repeato/ocr",
  "description": "Repeato OCR for Node.js and Electron main processes, based on PaddleOCR and ONNX Runtime",
  "keywords": [
    "ocr",
    "paddleocr",
    "typescript",
    "onnxruntime",
    "node"
  ],
  "version": "1.5.1",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/repeato-qa/ocr.git",
    "directory": "packages/node"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "react-native": "./src/index.ts",
      "types": "./build/node/src/index.d.ts",
      "default": "./build/node/src/index.js"
    },
    "./electron": {
      "bun": "./src/electron.ts",
      "react-native": "./src/electron.ts",
      "types": "./build/node/src/electron.d.ts",
      "default": "./build/node/src/electron.js"
    }
  },
  "files": [
    "src",
    "build",
    "!**/__tests__"
  ],
  "scripts": {
    "build": "rm -rf build && npx --no-install tsc --project tsconfig.build.json && npx --no-install tsc-alias --project tsconfig.build.json",
    "prepublishOnly": "cp ../../README.md . && npm run build",
    "postpublish": "rm README.md && rm -rf build"
  },
  "dependencies": {
    "@gutenye/ocr-common": "^1.2.0",
    "@gutenye/ocr-models": "^1.2.2",
    "onnxruntime-node": "1.22.0-rev",
    "sharp": "^0.34.3"
  }
}