{
  "name": "electron-example",
  "private": true,
  "type": "module",
  "main": "./build/main.cjs",
  "scripts": {
    "build": "node ./build.mjs",
    "start": "npm run build && electron .",
    "benchmark": "npm run build && electron . --benchmark ./build/assets/cn-01.jpg --iterations 3",
    "benchmark:main": "npm run build && electron . --benchmark ./build/assets/cn-01.jpg --iterations 3 --mode main",
    "benchmark:renderer": "npm run build && electron . --benchmark ./build/assets/cn-01.jpg --iterations 3 --mode renderer",
    "package": "npm run build && node ./scripts/package.mjs",
    "test:assets": "npm run build && node --test ./tests/ocr-assets.test.mjs",
    "test:smoke": "npm run build && electron . --smoke ./build/assets/cn-01.jpg",
    "test:smoke:main": "npm run build && electron . --smoke ./build/assets/cn-01.jpg --mode main",
    "test:smoke:packaged": "npm run package && node ./scripts/smoke-packaged.mjs",
    "test:smoke:renderer": "npm run build && electron . --smoke ./build/assets/cn-01.jpg --mode renderer"
  },
  "dependencies": {
    "electron": "^36.0.0",
    "esbuild": "^0.25.3",
    "onnxruntime-web": "^1.17.3",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@electron/packager": "^18.3.6",
    "@electron/rebuild": "^4.0.1"
  }
}