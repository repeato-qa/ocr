{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "#common/*": ["./packages/common/src/*"],
      "@gutenye/ocr-common": ["./packages/common/src/index.ts"],
      "@gutenye/ocr-common/splitIntoLineImages": ["./packages/common/src/backend/splitIntoLineImages.ts"],
      "@gutenye/ocr-models/node": ["./packages/models/node.js"],
      "@repeato/ocr": ["./packages/node/src/index.ts"],
      "@repeato/ocr/electron": ["./packages/browser/src/electron.ts"]
    },
    "lib": ["ESNext", "DOM"],
    "target": "ESNext",
    "module": "ESNext",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,

    // Bundler mode
    "moduleResolution": "Bundler",
    // "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,

    // Some stricter flags (disabled by default)
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["ios", "android"]
}
